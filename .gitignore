# --- Build outputs (Gradle / Android) ---
.gradle/
build/
.kotlin/
.externalNativeBuild/
.cxx/
captures/
*.apk
*.aab
*.ap_
*.dex
output-metadata.json

# --- Local machine config (SDK path, IDE state) ---
local.properties
.idea/
*.iml
.DS_Store

# --- Secrets: never commit signing keys or credentials ---
*.jks
*.keystore
keystore.properties
signing.properties
google-services.json
.env
.env.*

# --- Logs ---
*.log

# --- Material criptográfico del backend (generar_certificado.sh) ---
# Las claves privadas no se suben nunca. Los certificados tampoco: sin su clave
# no sirven, y la autoridad que necesita la aplicación ya está copiada en
# app/src/debug/res/raw/cert_laboratorio.pem.
backend/**/*.pem
backend/**/*.srl
